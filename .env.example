# ---------- Frontend (copy to .env) ----------
# Where the doubt-solver backend lives.
# Leave empty in development (Vite proxies /api to localhost:8787).
# In production / Android APK set the full URL of your deployed backend, e.g. https://boardbuddy-api.example.com
VITE_API_URL=

# Optional: public Instagram page link shown on the Connect screen (https://instagram.com/<name>). Leave empty to hide.
VITE_INSTAGRAM_URL=

# ---------- Backend (copy to server/.env) ----------
# Your Anthropic API key. NEVER put this in the frontend or commit it.
ANTHROPIC_API_KEY=
# Model used for the doubt solver
ANTHROPIC_MODEL=claude-sonnet-5-5
# Allowed website origin for CORS (your deployed frontend). Use * only for testing.
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
