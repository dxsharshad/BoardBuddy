# Frontend: Firebase web app configuration (these are public identifiers, protected by Firebase rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend: deployed API URL. Leave blank for local Vite proxy.
VITE_API_URL=

# Backend secrets/config belong in server/.env or your hosting provider's secret settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787

# Non-secret allowlist for the one initial admin email; do not use this as a substitute for server credentials.
BOARD_BUDDY_ADMIN_EMAIL=phoolnesha924@gmail.com
