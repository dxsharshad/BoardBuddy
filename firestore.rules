rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.verified == false;
      // User may update profile fields, but cannot change role, verified, uid or createdAt.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }
    // No public access to unpublished teacher notes or tests by default. Add narrow rules
    // only when the matching feature and trusted publication workflow are implemented.
    match /{document=**} { allow read, write: if false; }
  }
}
